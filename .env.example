# Copy to .env — never commit real values.

# Anthropic: diagnosis + second look (D2 Haiku)
ANTHROPIC_API_KEY=

# Replicate: generative family D3 (SDXL + ControlNet) and the Risoluzione module (Real-ESRGAN)
REPLICATE_API_TOKEN=

# cv-service (FastAPI). n8n Cloud reaches it through the ngrok tunnel.
CV_SERVICE_URL=http://localhost:8000
CV_SERVICE_PUBLIC_URL=            # ngrok https URL, changes at every restart

# Fidelity gate (see cv-service/app/config.py for the defaults)
FIDELITY_THRESHOLD=0.90

# n8n product webhook (…/webhook/photo-lab-product); the choice/summary/result/study
# webhooks of the 'scelte' workflow are derived from the same prefix
VITE_N8N_WEBHOOK_URL=

# id of the imported "Correggi" sub-workflow (n8n URL: /workflow/<id>)
N8N_CORRECT_WORKFLOW_ID=
